{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>brzzdev/renovate-config:automerge",
    "github>brzzdev/renovate-config:swift"
  ],
  "packageRules": [
    {
      "description": "rusqlite must match the version taskchampion pins, so its minors move by hand with taskchampion.",
      "enabled": false,
      "matchPackageNames": [
        "rusqlite"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ]
    }
  ]
}
